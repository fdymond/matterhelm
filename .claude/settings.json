{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run verify *)",
      "Bash(npm run coverage *)",
      "Bash(npm audit)",
      "Bash(npm audit --omit=dev)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr view *)"
    ],
    "deny": [
      "Edit(//c/Users/*/AppData/Roaming/MatterHelm/**)",
      "Read(//c/Users/*/AppData/Roaming/MatterHelm/matter/**)",
      "Read(/.matter-storage/**)",
      "Edit(/dist/**)",
      "Edit(/dist-installer/**)",
      "Edit(/dist.pre-*/**)",
      "Bash(git * --output*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-bridge.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
