{
  "name": "matterhelm-bridge",
  "version": "0.7.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fdymond/matterhelm.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/fdymond/matterhelm/issues"
  },
  "homepage": "https://github.com/fdymond/matterhelm#readme",
  "author": "MatterHelm contributors",
  "description": "MatterHelm's Matter virtual-device bridge sidecar — exposes a Windows HTPC to Google Home",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bridge.cjs --external:node:* --external:bun:sqlite --log-level=warning",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@matter/main": "0.17.7",
    "pino": "10.3.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
