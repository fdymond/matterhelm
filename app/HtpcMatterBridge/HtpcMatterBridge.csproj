<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HtpcMatterBridge</RootNamespace>
    <AssemblyName>HtpcMatterBridge</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-003 item 6: the one justified NuGet exception, for local/offline QR
         rendering (PngByteQRCode â€” no cloud QR service, no System.Drawing-coupled
         QRCode-Core renderer). MIT licensed; pinned exact per CLAUDE.md. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- S2-5: stub sidecar for the wired demo and the wiring tests (flows to
         referencing projects' output too). The real sidecar ships via S3-1. -->
    <Content Include="DemoAssets\StubSidecar.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
