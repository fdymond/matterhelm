<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HtpcMatterBridge</RootNamespace>
    <AssemblyName>HtpcMatterBridge</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-003 item 6: the one justified NuGet exception, for local/offline QR
         rendering (PngByteQRCode — no cloud QR service, no System.Drawing-coupled
         QRCode-Core renderer). MIT licensed; pinned exact per CLAUDE.md. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
